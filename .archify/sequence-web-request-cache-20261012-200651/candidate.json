  "cards": [
    {
      "dot": "emerald",
      "title": "Cache Hit",
      "items": [
        "If Redis returns a value, the API responds immediately",
        "PostgreSQL is never touched on a hit"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache Miss",
      "items": [
        "Redis returns nil, so the API falls back to PostgreSQL",
        "Rows from the database become the response payload"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Fill",
      "items": [
        "The API writes the result back to Redis with a TTL",
        "The next request for the same key is a hit"
      ]
    }
  ]
