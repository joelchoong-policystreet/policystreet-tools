  "cards": [
    {
      "dot": "emerald",
      "title": "Cache Hit",
      "items": [
        "Rows from localStorage render instantly as React Query initialData",
        "No full fetch runs because staleTime is Infinity"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache Miss",
      "items": [
        "The whole table is downloaded in pages of 1000, ordered by date",
        "Rows and fingerprint are saved together; quota errors are ignored"
      ]
    },
    {
      "dot": "cyan",
      "title": "Freshness",
      "items": [
        "No time-based expiry: only the fingerprint decides staleness",
        "A changed row count or updated_at triggers a full refetch"
      ]
    },
    {
      "dot": "slate",
      "title": "Shared Hook",
      "items": [
        "Consumer, Quotation Conversion and UTM Vehicle dashboards use the same flow with their own table and cache key"
      ]
    }
  ]
